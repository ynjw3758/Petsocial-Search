	public Map<String, Object>Search_MatFollower(String nickname, String Id){
		Map<String ,Object> data = new HashMap<String, Object>();
		Map<String, Object> insert_data = new HashMap<String ,Object>();
		List<PersonInfo> person_list = new ArrayList<PersonInfo>();
		String kor="";
		boolean ischo=false, isword=false;
		 logger.info("닉네임 검색 :"  + nickname);
		 
		 boolean isOnlyH = HangulEditor.isInOnlyHangul(nickname);
		 if(isOnlyH) {
			 logger.info("한글");
			 for(int i=0; i< nickname.length(); i++) {
				 if(HangulEditor.isConsonant(nickname.charAt(i))) {
					 ischo =true;
					 kor+=nickname.charAt(i);
				 }
				 else if(!HangulEditor.isVowels(nickname.charAt(i)) && 
	        			   !HangulEditor.isConsonant(nickname.charAt(i))) {
					 isword= true;
	        		   char chars = (char) (nickname.charAt(i) - 0xAC00);
	        		   if (chars >= 0 && chars <= 11172) {

	        		   int chosung= chars / (21 * 28);
	   				   int jungsung = chars % (21 * 28) / 28;
	   				   int jongsung = chars % (21 * 28) % 28;
	   				   
	   				   if(jongsung != 0x0000) {
	   					 kor+= ""+arrChoSung[chosung] +arrJungSung[jungsung] + arrJongSung[jongsung];
	   					 logger.info("완벽 :" + kor);
	   				   }
	   				   else {
	   					kor+= ""+arrChoSung[chosung] +arrJungSung[jungsung];
	   					logger.info("종성없음 :" + kor);
	   				   }
	   				   
	   				  
	   				   
	        		   }
				 }
			 }
			 
			 if(ischo == true && isword == false) {//초성만
				 insert_data.put("Nickname", kor);
				 insert_data.put("Id", Id);
				 
				 person_list = person_mapper.MatList_chosung(insert_data);
				 
				 if(person_list.size() ==0) {
		 	    		logger.info("없다");
		 	    		data.put("code", 204);
		 	    		data.put("msg", "empty");
		 	    		data.put("data", "null");
		 	    		
		 	    	}
		 	    	else {
		 	    		logger.info("있다");
		 	    		data.put("code", 200);
		 	    		data.put("msg", "success");
		 	    		data.put("data", person_list);
		 	    	}
				 
				 return data;
				 
			 }else {//그외 나머지는 쿼리는 같기 때문에
				 logger.info("뭐여");
				 insert_data.put("Nickname", kor);
				 insert_data.put("Id", Id);
				 person_list = person_mapper.MatList_initial(insert_data);
				 
				 if(person_list.size() ==0) {
		 	    		logger.info("없다");
		 	    		data.put("code", 204);
		 	    		data.put("msg", "empty");
		 	    		data.put("data", "null");
		 	    		
		 	    	}
		 	    	else {
		 	    		logger.info("있다");
		 	    		data.put("code", 200);
		 	    		data.put("msg", "success");
		 	    		data.put("data", person_list);
		 	    	}
			 }
       
			 
			 
		 }
		 else {
			 logger.info("영어");
				insert_data.put("Id", Id);
				insert_data.put("Nickname", nickname);
			 person_list = person_mapper.MatList_initial(insert_data);
    	    	if(person_list.size() ==0) {
 	    		logger.info("없다");
 	    		data.put("code", 204);
 	    		data.put("msg", "empty");
 	    		data.put("data", "null");
 	    		
 	    	}
 	    	else {
 	    		logger.info("있다");
 	    		data.put("code", 200);
 	    		data.put("msg", "success");
 	    		data.put("data", person_list);
 	    	}
			 
		 }
		 
		
		return data;
		
	}
