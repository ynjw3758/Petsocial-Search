	public int findjong(char word) {
		
		int values=0;
		for(int i=0; i<arrJongSung.length; i++ ) {
			if(word == arrJongSung[i]) {
				values=i;
				break;
			}
			else continue;
		}
		
		return values;
		
	}
	
